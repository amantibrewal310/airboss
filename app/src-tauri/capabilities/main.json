{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every command except the quick-add panel's own.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-bootstrap",
    "allow-task-detail",
    "allow-run-map",
    "allow-plans",
    "allow-quickadd-data",
    "allow-t3-projects",
    "allow-herdr-folders",
    "allow-create-task",
    "allow-rename-task",
    "allow-edit-notes",
    "allow-set-status",
    "allow-toggle-done",
    "allow-accept-proposals",
    "allow-reject-proposals",
    "allow-move-task",
    "allow-reorder",
    "allow-link-repo",
    "allow-unlink-repo",
    "allow-add-repos",
    "allow-edit-repo",
    "allow-remove-repo",
    "allow-back-up-database",
    "allow-pick-folder",
    "allow-set-branch",
    "allow-add-dependency",
    "allow-remove-dependency",
    "allow-add-link",
    "allow-remove-link",
    "allow-add-note",
    "allow-do-it",
    "allow-plan-it",
    "allow-add-to-t3",
    "allow-reopen-and-start",
    "allow-open-thread",
    "allow-open-url",
    "allow-needs-dismiss",
    "allow-needs-snooze",
    "allow-needs-restore",
    "allow-undo",
    "allow-recheck-connections",
    "allow-copy-text",
    "allow-install-cli",
    "allow-connect-claude",
    "allow-get-settings",
    "allow-set-settings",
    "allow-notification-permission",
    "allow-open-notification-settings",
    "allow-set-folded",
    "allow-set-focus-context",
    "allow-ui-ready",
    "allow-show-main"
  ]
}
